# Copy to .env and adjust. Never commit the real .env.

# ---- Flask ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value-at-least-32-chars
FLASK_CONFIG=development
FLASK_DEBUG=1

# ---- JWT ----
JWT_SECRET_KEY=change-me-to-a-different-long-random-value-32chars
# Must be true in production (ProductionConfig refuses to boot otherwise).
JWT_COOKIE_SECURE=false

# ---- Database ----
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/ems_dev
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/ems_test

# ---- Redis / Celery ----
# On Railway this comes from the Redis plugin. Reference it as
# ${{Redis.REDIS_URL}} instead of copying the value, so credentials stay managed.
REDIS_URL=redis://127.0.0.1:6379/0
# Only needed when REDIS_URL is a rediss:// (TLS) URL, as some Railway plans
# provide: Celery's Redis client otherwise looks for a local CA bundle.
# REDIS_SSL_CERT_REQS=none

# ---- Rate limiting ----
# memory:// in development; point at Redis in production.
RATELIMIT_STORAGE_URI=memory://

# ---- Reverse proxy ----
# Trust X-Forwarded-* from the platform proxy. Keep true on Railway/Render/Fly:
# without it every request appears to come from the proxy, so rate limiting
# collapses into a single global limit.
TRUST_PROXY_HEADERS=true

# ---- CORS ----
# "*" in development; an explicit comma-separated list in production.
CORS_ORIGINS=*

# ---- Outbound email ----
# console : write each email to the log and mark it sent (no SMTP needed).
#           Use this in development to see exactly what would be delivered.
# smtp    : deliver for real over SMTP.
# null    : record without delivering (tests).
EMAIL_BACKEND=console
EMAIL_ENABLED=true
EMAIL_SUBJECT_PREFIX=[EMS]
# Attempts before an email is parked as failed. The email_dispatch job retries.
EMAIL_MAX_ATTEMPTS=3

# Public base URL used to build links inside email bodies.
# IMPORTANT: set this to your real public address before deploying, or every
# sign-in link in a welcome email will point at localhost.
APP_BASE_URL=http://127.0.0.1:5000

# Organisation name shown to users and in email signatures.
APP_NAME=Employee Management System
# Where employees go to register a fingerprint; used in the welcome email.
HR_CONTACT=the HR office

# ---- Mail (only used when EMAIL_BACKEND=smtp) ----
# For Gmail: smtp.gmail.com, 587, SMTP_TLS=true, and an App Password
# (not your account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ems.local
SMTP_TLS=true
# Set true instead of TLS for implicit TLS on port 465.
SMTP_SSL=false
SMTP_TIMEOUT=20

# ---- SMS ----
# The SMS sender is a stub until a provider is wired into
# app/features/notifications/senders.py.
SMS_ENABLED=false

# ---- Domain ----
DEFAULT_TIMEZONE=Africa/Nairobi
