# Secrets — never commit the real environment file.
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local artefacts
logs/
*.log

# Celery beat's local schedule state (container-local; never committed)
celerybeat-schedule*
celerybeat.pid

# pip scratch directories created inside the workspace when the sandbox
# redirects pip's temp/cache paths
.piptmp/
.pipcache/
