# Keep the image lean and reproducible: nothing here is needed at runtime.
.git
.gitignore
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache

# Local configuration and secrets never belong in an image.
.env
.env.*
!.env.example

# Tests and tooling are not part of the running service.
tests/
tools/
pytest.ini

# Local artefacts.
*.log
*.sqlite3
celerybeat-schedule*
.DS_Store
Thumbs.db
